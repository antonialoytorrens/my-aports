# Contributor: Antoni Aloy <antoni.aloytorrens@gmail.com>
# Maintainer: Antoni Aloy <antoni.aloytorrens@gmail.com>
pkgname=seafile
pkgver=9.0.21
pkgrel=0
pkgdesc="Seafile client daemon, libraries and CLI (seaf-cli)"
url="https://github.com/haiwen/seafile"
arch="all"
license="GPL-2.0-only"
depends=""
depends_dev="
	libsearpc-dev
	glib-dev
	jansson-dev
	libevent-dev
	curl-dev
	sqlite-dev
	openssl-dev
	libwebsockets-dev
	argon2-dev
	"
makedepends="
	$depends_dev
	autoconf
	automake
	libtool
	vala
	intltool
	util-linux-dev
	gnutls-dev
	nettle-dev
	zlib-dev
	python3-dev
	py3-setuptools
	"
# cli before -doc so seaf-cli.1 stays with seafile-cli
subpackages="
	$pkgname-cli:cli
	$pkgname-dev
	$pkgname-libs
	py3-$pkgname:py
	$pkgname-doc
	"
source="$pkgname-$pkgver.tar.gz::https://github.com/haiwen/seafile/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/seafile-$pkgver"
options="!check"

prepare() {
	default_prepare
	./autogen.sh
}

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--localstatedir=/var \
		--disable-static \
		--enable-ws \
		--with-python3 \
		--with-gpl-crypto=yes
	make
}

package() {
	make DESTDIR="$pkgdir" install
	find "$pkgdir" -name '*.la' -delete
}

py() {
	pkgdesc="Python 3 bindings for Seafile"
	depends="py3-searpc $pkgname-libs=$pkgver-r$pkgrel python3"
	amove usr/lib/python*
}

cli() {
	arch="noarch"
	pkgdesc="Seafile client CLI (seaf-cli)"
	depends="
		py3-$pkgname=$pkgver-r$pkgrel
		$pkgname=$pkgver-r$pkgrel
		python3
		"
	amove usr/bin/seaf-cli
	amove usr/share/man/man1/seaf-cli.1*
}

sha512sums="
4b760d3db7e2216bfdf63051ce60790e93c8dffa89c6962592fdb15da298e667eea2fc59fa49a4bfc0361f5bb9b750e5ab35becc9eefe69345d2ab2ca212ca07  seafile-9.0.21.tar.gz
"
