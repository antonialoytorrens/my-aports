# Contributor: Antoni Aloy <antoni.aloytorrens@gmail.com>
# Maintainer: Antoni Aloy <antoni.aloytorrens@gmail.com>
pkgname=libsearpc
pkgver=3.3.0_git20260612
_commit=23d5df62815fb3b7825bf4e1a28b29af701e8cb2
pkgrel=0
pkgdesc="Simple RPC framework based on GObject System (Seafile)"
url="https://github.com/haiwen/libsearpc"
arch="all"
license="Apache-2.0 AND BSD-3-Clause"
depends_dev="glib-dev jansson-dev"
makedepends="
	$depends_dev
	autoconf
	automake
	libtool
	python3-dev
	py3-setuptools
	"
subpackages="$pkgname-dev py3-searpc:py $pkgname-doc"
source="$pkgname-$_commit.tar.gz::https://github.com/haiwen/libsearpc/archive/$_commit.tar.gz"
builddir="$srcdir/libsearpc-$_commit"
options="!check"

prepare() {
	default_prepare
	./autogen.sh
}

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--localstatedir=/var \
		--disable-static \
		--disable-compile-demo \
		--with-python3
	make
}

package() {
	make DESTDIR="$pkgdir" install
	find "$pkgdir" -name '*.la' -delete
}

py() {
	pkgdesc="Python 3 bindings for $pkgname"
	depends="python3 py3-simplejson"
	amove usr/lib/python*
}

sha512sums="
"
